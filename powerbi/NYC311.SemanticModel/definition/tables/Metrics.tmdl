table Metrics
	lineageTag: a58da793-c725-0f1b-3b8f-8710efd7c7ee

	column placeholder
		dataType: int64
		sourceColumn: placeholder
		isHidden
		summarizeBy: none

	partition Metrics = m
		mode: import
		source = #table(type table [placeholder = Int64.Type], {{1}})

	/// Creation-date period; requests with a known local creation date within the pinned cohort.
	measure 'Intake' =
			COALESCE(COUNTROWS(FILTER('Cases', NOT ISBLANK('Cases'[created_date]))), 0)
		lineageTag: 799672db-f026-f163-a3ba-c47c952dffb9
		formatString: #,0

	/// Closure-date period; only requests created within the pinned cohort.
	measure 'Recorded closures' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_recorded_closure] = TRUE(), USERELATIONSHIP('Date'[date_key], 'Cases'[closed_date])), 0)
		lineageTag: 962fb0f0-6005-bb4d-23b7-31292882bae0
		formatString: #,0

	/// Selected release observation; independent of the activity date period.
	measure 'Observed backlog' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			RETURN IF(NOT ISBLANK(Snapshot), COALESCE(CALCULATE(SUM('Backlog'[open_count]), 'Backlog'[snapshot_id] = Snapshot, 'Backlog'[is_release_snapshot] = TRUE()), 0))
		lineageTag: af3915f3-dea1-b215-5649-d75391d5d2e9
		formatString: #,0

	/// Open for at least 168 elapsed hours at the selected observation.
	measure 'Backlog 7d+' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			RETURN IF(NOT ISBLANK(Snapshot), COALESCE(CALCULATE(SUM('Backlog'[age_168h_plus_count]), 'Backlog'[snapshot_id] = Snapshot, 'Backlog'[is_release_snapshot] = TRUE()), 0))
		lineageTag: a84e62cd-0b57-a22c-535b-2ebaf09558a5
		formatString: #,0

	/// Mature eligible cases recorded closed within the assigned demonstration target; creation-date period.
	measure 'Demo target met' =
			COALESCE(SUM('Cases'[target_numerator]), 0)
		lineageTag: 32d07ba6-afde-522d-df1f-ba30c4f31c7c
		formatString: #,0

	/// All mature eligible cases in the creation-date period, including overdue open and late closed misses.
	measure 'Demo target eligible' =
			COALESCE(SUM('Cases'[target_denominator]), 0)
		lineageTag: 0c074ee6-18f4-87d9-3a95-f656bf282b87
		formatString: #,0

	/// Ratio of summed numerator to summed denominator. BLANK when no eligible mature cases.
	measure 'Within demo target %' =
			DIVIDE([Demo target met], [Demo target eligible])
		lineageTag: 0ef2d083-80f9-238c-9f02-ce19d4453ea8
		formatString: 0.0%

	/// Eligible case rows in the selected closure-date period.
	measure 'P90 eligible closures' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_p90_eligible] = TRUE(), USERELATIONSHIP('Date'[date_key], 'Cases'[closed_date])), 0)
		lineageTag: a3f26c10-9d2e-130c-30b4-664d02ad1179
		formatString: #,0

	/// Continuous/interpolated percentile across eligible case rows, not an average of segment percentiles.
	measure 'P90 hours to recorded closure' =
			VAR Eligible = CALCULATETABLE(FILTER('Cases', 'Cases'[is_p90_eligible] = TRUE() && NOT ISBLANK('Cases'[elapsed_hours])), USERELATIONSHIP('Date'[date_key], 'Cases'[closed_date]))
			RETURN IF(COUNTROWS(Eligible) > 0, PERCENTILEX.INC(Eligible, 'Cases'[elapsed_hours], 0.9))
		lineageTag: f70ea0e0-5a69-0651-287f-8f6c6658414f
		formatString: 0.0

	/// Creation-date period. Missing-target diagnostic; not in the mature eligible denominator.
	measure 'Missing demo target' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_missing_target] = TRUE()), 0)
		lineageTag: b8492003-b7e0-6859-2ca1-a2a8b364db12
		formatString: #,0

	/// Creation-date period. Assigned threshold has not elapsed by the observation.
	measure 'Immature cases' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_immature] = TRUE()), 0)
		lineageTag: ad91078b-586c-6083-b8f1-2aaac6ba7639
		formatString: #,0

	/// Creation-date period. Invalid chronology or inconsistent outcome.
	measure 'Invalid outcomes' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_invalid_outcome] = TRUE()), 0)
		lineageTag: 6d099835-0b14-274b-b677-d3eb5714b76a
		formatString: #,0

	/// Creation-date period. Status does not support a known open/closed outcome.
	measure 'Unknown outcomes' =
			COALESCE(CALCULATE(COUNTROWS('Cases'), 'Cases'[is_unknown_outcome] = TRUE()), 0)
		lineageTag: 547bb089-a9f4-c6ec-564c-bc6e260972b5
		formatString: #,0

	/// Open requests by elapsed age at the single selected capture.
	measure 'Backlog by age' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			RETURN IF(NOT ISBLANK(Snapshot), CALCULATE(SWITCH(SELECTEDVALUE('Age Bucket'[bucket]), "Under 24h", SUM('Backlog'[age_under_24h_count]), "24–72h", SUM('Backlog'[age_24_to_72h_count]), "72–168h", SUM('Backlog'[age_72_to_168h_count]), "168h+", SUM('Backlog'[age_168h_plus_count]), "Unknown age", SUM('Backlog'[age_unknown_count])), 'Backlog'[snapshot_id] = Snapshot, 'Backlog'[is_release_snapshot] = TRUE()))
		lineageTag: 762d0cb7-c3ce-f3a0-cc2d-212c180fa89a
		formatString: #,0

	/// Detail rows are open or mature eligible; selecting an age bar narrows details to open requests in that bucket, while retaining creation-date filtering.
	measure 'Request detail visible' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			VAR IsOpen = SELECTEDVALUE('Cases'[is_backlog]) = TRUE()
			VAR AgeOrder = SWITCH(SELECTEDVALUE('Cases'[age_bucket]), "Under 24 hours", 1, "24 to under 72 hours", 2, "72 to under 168 hours", 3, "168 hours or more", 4, "Unknown age", 5)
			VAR AgeMatches = NOT ISFILTERED('Age Bucket') || (IsOpen && CONTAINS(VALUES('Age Bucket'[sort_order]), 'Age Bucket'[sort_order], AgeOrder))
			RETURN IF(SELECTEDVALUE('Cases'[snapshot_id]) = Snapshot && AgeMatches && (IsOpen || SELECTEDVALUE('Cases'[target_denominator]) = 1), 1, 0)
		lineageTag: cc4934ed-1b7f-e8c4-6df9-907c1a45ce61
		formatString: 0

	/// Elapsed age at observation for open requests only; closed request rows remain BLANK.
	measure 'Open request age hours' =
			IF(SELECTEDVALUE('Cases'[is_backlog]) = TRUE(), SELECTEDVALUE('Cases'[age_hours]))
		lineageTag: d3fdeb1d-66f7-ccdf-189a-b0816460040b
		formatString: 0.0

	/// Visible segment context includes drill-through filters even when slicer captions say All.
	measure 'Selected segment' =
			"Agency: " & IF(HASONEVALUE('Agency'[agency]), SELECTEDVALUE('Agency'[agency]), "All") & " | Problem: " & IF(HASONEVALUE('Problem'[problem]), SELECTEDVALUE('Problem'[problem]), "All") & " | Borough: " & IF(HASONEVALUE('Borough'[borough]), SELECTEDVALUE('Borough'[borough]), "All")
		lineageTag: 143bff17-9bda-7bf3-f75e-69e80de0ee94

	/// Selected completed observation and provenance.
	measure 'Release context' =
			"Release " & SELECTEDVALUE('Release'[release_id], "INVALID") & " | " & SELECTEDVALUE('Release'[source_kind], "UNKNOWN") & " | As of " & FORMAT(SELECTEDVALUE('Release'[observed_at]), "yyyy-MM-dd HH:mm") & " UTC"
		lineageTag: d6b9cf3a-d4fe-8aab-dcce-85191618223d

	/// Pinned creation cohort and complete-extract count; not citywide workload.
	measure 'Cohort coverage' =
			"Created " & FORMAT(SELECTEDVALUE('Release'[cohort_start]), "yyyy-MM-dd") & " through " & FORMAT(SELECTEDVALUE('Release'[cohort_end]) - 1, "yyyy-MM-dd") & " (NYC) | Captured " & FORMAT(SELECTEDVALUE('Release'[source_count]), "#,0") & " / " & FORMAT(SELECTEDVALUE('Release'[expected_count]), "#,0") & " requests"
		lineageTag: 5b317b73-dd9b-1107-22be-2beb0e0879c5

	/// Explicit date roles; backlog does not respond to the activity period.
	measure 'Period context' =
			"Activity period: " & FORMAT(MIN('Date'[date_key]), "yyyy-MM-dd") & " to " & FORMAT(MAX('Date'[date_key]), "yyyy-MM-dd") & ". Intake/targets use creation; closures/p90 use closure; backlog uses the displayed observation."
		lineageTag: 0c634361-56e8-1e66-2c82-05c502838e91

	/// Segment with most observed open requests aged at least seven days; deterministic ties use open count then agency/problem/borough.
	measure 'Priority segment' =
			VAR Segments = CALCULATETABLE(SUMMARIZE('Backlog', 'Agency'[agency], 'Problem'[problem], 'Borough'[borough], "__Aged", [Backlog 7d+], "__Open", [Observed backlog]), REMOVEFILTERS('Date'))
			VAR Ranked = TOPN(1, FILTER(Segments, [__Aged] > 0), [__Aged], DESC, [__Open], DESC, 'Agency'[agency], ASC, 'Problem'[problem], ASC, 'Borough'[borough], ASC)
			RETURN IF(COUNTROWS(Ranked) > 0, MAXX(Ranked, 'Agency'[agency] & " / " & 'Problem'[problem] & " / " & 'Borough'[borough]))
		lineageTag: 3708d890-7c28-439e-6c27-f284841501d3

	/// Seven-day-plus open count of the recommended segment; BLANK when no aged backlog in the selected scope.
	measure 'Priority aged count' =
			VAR Segments = CALCULATETABLE(SUMMARIZE('Backlog', 'Agency'[agency], 'Problem'[problem], 'Borough'[borough], "__Aged", [Backlog 7d+], "__Open", [Observed backlog]), REMOVEFILTERS('Date'))
			VAR Ranked = TOPN(1, FILTER(Segments, [__Aged] > 0), [__Aged], DESC, [__Open], DESC, 'Agency'[agency], ASC, 'Problem'[problem], ASC, 'Borough'[borough], ASC)
			RETURN MAXX(Ranked, [__Aged])
		lineageTag: ef987b91-36d5-abf9-d96b-4b30933a2338
		formatString: #,0

	/// Presentation-only priority count; an em dash denotes no recommended aged segment, while the numeric measure remains BLANK.
	measure 'Priority aged display' =
			IF(ISBLANK([Priority aged count]), "—", FORMAT([Priority aged count], "#,0"))
		lineageTag: 5ffba40a-be59-8776-1774-7c2a44e3c1a7

	/// All observed open requests in the recommended segment.
	measure 'Priority open count' =
			VAR Segments = CALCULATETABLE(SUMMARIZE('Backlog', 'Agency'[agency], 'Problem'[problem], 'Borough'[borough], "__Aged", [Backlog 7d+], "__Open", [Observed backlog]), REMOVEFILTERS('Date'))
			VAR Ranked = TOPN(1, FILTER(Segments, [__Aged] > 0), [__Aged], DESC, [__Open], DESC, 'Agency'[agency], ASC, 'Problem'[problem], ASC, 'Borough'[borough], ASC)
			RETURN MAXX(Ranked, [__Open])
		lineageTag: e3255e47-001b-ae97-6e79-fb637d98b027
		formatString: #,0

	/// Recommended segment share of all aged backlog in the selected agency/problem/borough scope.
	measure 'Priority aged share' =
			DIVIDE([Priority aged count], [Backlog 7d+])
		lineageTag: 17f726db-d667-d4e4-d872-ddf246fb5162
		formatString: 0.0%

	/// Share of the recommended segment open requests aged seven days or more.
	measure 'Priority aged rate' =
			DIVIDE([Priority aged count], [Priority open count])
		lineageTag: 227a4990-ef14-1018-3487-52e57927f97b
		formatString: 0.0%

	/// Filter-aware recommendation; this does not assert operational cause.
	measure 'Priority headline' =
			IF(NOT ISBLANK([Priority segment]), "Review " & [Priority segment] & " first", "No requests aged 7+ days in this selection")
		lineageTag: 89273b87-d653-4a0a-ce4d-a7cf4f763e54

	/// Visible evidence behind the priority, always respecting the selected segment scope.
	measure 'Priority evidence' =
			IF(NOT ISBLANK([Priority aged count]), FORMAT([Priority aged count], "#,0") & " of " & FORMAT([Backlog 7d+], "#,0") & " requests in the filtered aged backlog (" & FORMAT([Priority aged share], "0.0%") & "). Start with the oldest IDs.", "Choose another segment or review the open-request worklist.")
		lineageTag: 2c3de232-1bde-1aba-b451-c824897f8608

	/// Only full Monday-to-Sunday weeks inside the creation cohort and selected activity dates.
	measure 'Comparable week' =
			VAR WeekStart = SELECTEDVALUE('Date'[week_start])
			RETURN IF(NOT ISBLANK(WeekStart) && WeekStart >= SELECTEDVALUE('Release'[cohort_start]) && WeekStart + 7 <= SELECTEDVALUE('Release'[cohort_end]) && COUNTROWS(VALUES('Date'[date_key])) = 7, 1, 0)
		lineageTag: 81491a7d-85c0-06a8-8ad4-4f18b8aaf44d
		formatString: 0

	/// Creation events within complete comparable weeks; out-of-cohort and partial selected weeks return BLANK.
	measure 'Complete week intake' =
			IF([Comparable week] = 1, [Intake])
		lineageTag: a8be6a83-1e0e-3aa7-5abf-224e0e0492dd
		formatString: #,0

	/// Recorded closure events in the same complete weeks; limited to requests created in the pinned cohort.
	measure 'Complete week closures' =
			IF([Comparable week] = 1, [Recorded closures])
		lineageTag: f89d43e3-1c3d-e2e3-9124-33f9ddeacbb6
		formatString: #,0

	/// Count of complete selected weeks eligible for the comparative trend.
	measure 'Complete week count' =
			COALESCE(COUNTROWS(FILTER(VALUES('Date'[week_start]), CALCULATE([Comparable week]) = 1)), 0)
		lineageTag: 8d62d5c2-9c2e-cd90-4741-8c23151f1d8a
		formatString: 0

	/// Makes the comparable-week restriction explicit; intake uses creation dates and recorded closures use closure dates.
	measure 'Trend context' =
			FORMAT([Complete week count], "0") & " full cohort weeks · partial weeks omitted."
		lineageTag: 7d4c2ca1-06bd-3993-6865-898ec14502e2

	/// Open at least thirty elapsed days at the observed snapshot; ignores activity date.
	measure 'Open 30d+' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			RETURN COALESCE(CALCULATE(COUNTROWS('Cases'), REMOVEFILTERS('Date'), 'Cases'[snapshot_id] = Snapshot, 'Cases'[is_backlog] = TRUE(), 'Cases'[age_hours] >= 720), 0)
		lineageTag: 85eaabeb-7956-0da0-2c40-daade4a1e6a4
		formatString: #,0

	/// Maximum open-request age in days at observation; BLANK if no open requests.
	measure 'Oldest open days' =
			VAR Snapshot = SELECTEDVALUE('Release'[snapshot_id])
			RETURN DIVIDE(CALCULATE(MAX('Cases'[age_hours]), REMOVEFILTERS('Date'), 'Cases'[snapshot_id] = Snapshot, 'Cases'[is_backlog] = TRUE()), 24)
		lineageTag: 43bd1f75-4793-0ca4-e821-96ccbcebf58e
		formatString: 0.0

	/// Eligible mature late-closed or overdue-open requests; creation-date period.
	measure 'Demo target misses' =
			[Demo target eligible] - [Demo target met]
		lineageTag: 89e922dd-9d3d-d080-6174-686f1d68cb7d
		formatString: #,0

	/// Eligible denominator displayed alongside the p90 KPI.
	measure 'P90 context' =
			"hours · " & FORMAT([P90 eligible closures], "#,0") & " eligible closures"
		lineageTag: 13d74c09-28f5-9adf-394d-20e391671b25

	/// Keeps numerator, denominator, and misses visible with the demo-target rate.
	measure 'Target evidence' =
			IF([Demo target eligible] > 0, FORMAT([Demo target met], "#,0") & " / " & FORMAT([Demo target eligible], "#,0") & " mature eligible · " & FORMAT([Demo target misses], "#,0") & " misses", "No mature eligible requests in the selected creation period")
		lineageTag: 818963c0-9d4c-0202-1912-db8cfe938a33

	/// Visible selected-segment heading, including drillthrough filters.
	measure 'Investigation headline' =
			IF(HASONEVALUE('Problem'[problem]) && HASONEVALUE('Borough'[borough]), SELECTEDVALUE('Borough'[borough]) & " / " & SELECTEDVALUE('Problem'[problem]), "Investigate the selected request scope")
		lineageTag: 5e3b5782-09db-bb91-eb5c-6cc46c350f4a

	/// Human-readable request-level eligibility.
	measure 'Request eligibility label' =
			SWITCH(SELECTEDVALUE('Cases'[target_eligibility_reason]), "eligible_mature", "Mature · eligible", "immature", "Not yet mature", "missing_target", "Missing demo target", "invalid_outcome", "Invalid outcome", "unknown_outcome", "Unknown outcome")
		lineageTag: e8ce79cb-28f5-2bc3-2921-4cea60d791e9

	/// Count of request worklist rows after activity-period and optional open-age selection.
	measure 'Visible worklist rows' =
			COALESCE(SUMX(VALUES('Cases'[request_id]), [Request detail visible]), 0)
		lineageTag: 88d9854d-e351-2596-74ab-46999656ad09
		formatString: #,0
